# Public site origin. Production is the www host.
NEXT_PUBLIC_SITE_URL=https://www.midnightcoderschildren.com

# Existing Meta pixel / dataset. Live value: 1561129122079440 (Midnight Coders).
NEXT_PUBLIC_META_DATASET_ID=1561129122079440

# Existing Meta Conversions API token. Server only. Never commit a real token.
# If empty, the browser pixel still fires after consent and CAPI no-ops.
META_CONVERSIONS_ACCESS_TOKEN=

# Existing Google Analytics 4. Falls back to G-PT2G856FD7 when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Existing OpenAI ads pixel. Leave empty to ship no OpenAI script.
NEXT_PUBLIC_OPENAI_PIXEL_ID=

# Stripe. Required for the direct EPUB checkout only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Beehiiv. Required for POST /api/subscribe.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Resend. Required for purchase emails.
RESEND_API_KEY=

# PostHog. Product analytics, separate from marketing pixels.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
