# Public site origin. Production is the www host.
NEXT_PUBLIC_SITE_URL=https://www.midnightcoderschildren.com

# Meta Pixel (Ads Manager name: Midnight Coders). Public.
# Defaults to 1561129122079440 when unset.
NEXT_PUBLIC_META_PIXEL_ID=1561129122079440
META_PIXEL_ID=1561129122079440

# Meta Conversions API. Server only. Never commit a real token.
# If this is empty, the browser pixel still fires after consent and CAPI no-ops.
META_CAPI_ACCESS_TOKEN=

# Google Analytics 4. Leave empty to ship no gtag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenAI ads pixel. Leave empty to ship no OpenAI script.
NEXT_PUBLIC_OPENAI_PIXEL_ID=

# Stripe. Required for the direct EPUB checkout only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Beehiiv. Required for POST /api/subscribe.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Resend. Required for purchase emails.
RESEND_API_KEY=

# PostHog. Product analytics, separate from marketing pixels.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
